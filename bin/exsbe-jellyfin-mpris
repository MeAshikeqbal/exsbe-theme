#!/usr/bin/env python3
"""Show what Jellyfin is playing (on any device) in Plasma's media controls.

Polls the server's sessions with an API key from KWallet (service=exsbe-pve,
account=jellyfin) and, while something plays, owns org.mpris.MediaPlayer2.jellyfin
so the top-bar media widget and lock screen show it; play/pause/next/previous/stop/seek
are sent back to that session. Usage: exsbe-jellyfin-mpris [SERVER_URL]
"""
import json, subprocess, sys, urllib.request
from gi.repository import Gio, GLib

SERVER = (sys.argv[1] if len(sys.argv) > 1 else "http://192.0.2.104:8096").rstrip("/")
BUS_NAME = "org.mpris.MediaPlayer2.jellyfin"
PATH = "/org/mpris/MediaPlayer2"
XML = """<node>
 <interface name="org.mpris.MediaPlayer2">
  <method name="Raise"/><method name="Quit"/>
  <property name="CanQuit" type="b" access="read"/><property name="CanRaise" type="b" access="read"/>
  <property name="HasTrackList" type="b" access="read"/><property name="Identity" type="s" access="read"/>
  <property name="DesktopEntry" type="s" access="read"/>
  <property name="SupportedUriSchemes" type="as" access="read"/><property name="SupportedMimeTypes" type="as" access="read"/>
 </interface>
 <interface name="org.mpris.MediaPlayer2.Player">
  <method name="Next"/><method name="Previous"/><method name="Pause"/><method name="PlayPause"/>
  <method name="Stop"/><method name="Play"/>
  <method name="Seek"><arg direction="in" name="Offset" type="x"/></method>
  <method name="SetPosition"><arg direction="in" name="TrackId" type="o"/><arg direction="in" name="Position" type="x"/></method>
  <signal name="Seeked"><arg name="Position" type="x"/></signal>
  <property name="PlaybackStatus" type="s" access="read"/><property name="Rate" type="d" access="read"/>
  <property name="Metadata" type="a{sv}" access="read"/><property name="Volume" type="d" access="read"/>
  <property name="Position" type="x" access="read"/><property name="MinimumRate" type="d" access="read"/>
  <property name="MaximumRate" type="d" access="read"/><property name="CanGoNext" type="b" access="read"/>
  <property name="CanGoPrevious" type="b" access="read"/><property name="CanPlay" type="b" access="read"/>
  <property name="CanPause" type="b" access="read"/><property name="CanSeek" type="b" access="read"/>
  <property name="CanControl" type="b" access="read"/>
 </interface>
</node>"""


def api_key():
    r = subprocess.run(["secret-tool", "lookup", "service", "exsbe-pve", "account", "jellyfin"],
                       capture_output=True, text=True)
    return r.stdout.strip()


class Bridge:
    def __init__(self):
        self.key = api_key()
        if not self.key:
            sys.exit("no Jellyfin API key in KWallet; run: exsbe-secret jellyfin")
        self.conn = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.info = Gio.DBusNodeInfo.new_for_xml(XML)
        self.session, self.owner, self.regs = None, 0, []

    # --- Jellyfin ---------------------------------------------------------------
    def req(self, path, method="GET"):
        r = urllib.request.Request(SERVER + path, method=method, data=b"" if method == "POST" else None,
                                   headers={"Authorization": f'MediaBrowser Token="{self.key}"'})
        with urllib.request.urlopen(r, timeout=4) as resp:
            body = resp.read()
            return json.loads(body) if body else None

    def poll(self):
        try:
            sessions = self.req("/Sessions?activeWithinSeconds=120")
            playing = [s for s in sessions if s.get("NowPlayingItem")]
            # prefer one that is actually playing over a paused one
            playing.sort(key=lambda s: s.get("PlayState", {}).get("IsPaused", False))
            self.update(playing[0] if playing else None)
        except Exception as e:
            print(f"poll: {e}", file=sys.stderr)
        GLib.timeout_add_seconds(2 if self.session else 8, self.poll)
        return False

    def command(self, cmd, query=""):
        if self.session:
            try:
                self.req(f'/Sessions/{self.session["Id"]}/Playing/{cmd}{query}', "POST")
            except Exception as e:
                print(f"{cmd}: {e}", file=sys.stderr)
            GLib.timeout_add(400, lambda: (self.poll_once(), False)[1])

    def poll_once(self):
        try:
            playing = [s for s in self.req("/Sessions?activeWithinSeconds=120") if s.get("NowPlayingItem")]
            playing.sort(key=lambda s: s.get("PlayState", {}).get("IsPaused", False))
            self.update(playing[0] if playing else None)
        except Exception:
            pass

    # --- MPRIS state --------------------------------------------------------------
    def metadata(self):
        it = self.session["NowPlayingItem"]
        title = it.get("Name", "")
        if it.get("Type") == "Episode":
            artist = it.get("SeriesName", "")
            if it.get("ParentIndexNumber") is not None and it.get("IndexNumber") is not None:
                title = f'S{it["ParentIndexNumber"]}E{it["IndexNumber"]} · {title}'
        else:
            artist = ", ".join(it.get("Artists") or []) or it.get("AlbumArtist", "") or str(it.get("ProductionYear", ""))
        art_id = it.get("AlbumId") if it.get("Type") == "Audio" and it.get("AlbumId") else it.get("SeriesId") or it["Id"]
        md = {
            "mpris:trackid": GLib.Variant("o", f'/org/jellyfin/item/{it["Id"]}'),
            "xesam:title": GLib.Variant("s", title),
            "xesam:artist": GLib.Variant("as", [a for a in [artist] if a]),
            "xesam:album": GLib.Variant("s", it.get("Album") or f'on {self.session.get("DeviceName", "")}'),
            "mpris:artUrl": GLib.Variant("s", f"{SERVER}/Items/{art_id}/Images/Primary?maxHeight=400"),
        }
        if it.get("RunTimeTicks"):
            md["mpris:length"] = GLib.Variant("x", it["RunTimeTicks"] // 10)
        return md

    def props(self, iface):
        s = self.session or {}
        ps = s.get("PlayState", {})
        if iface == "org.mpris.MediaPlayer2":
            return {"CanQuit": GLib.Variant("b", False), "CanRaise": GLib.Variant("b", False),
                    "HasTrackList": GLib.Variant("b", False),
                    "Identity": GLib.Variant("s", "Jellyfin · " + s.get("DeviceName", "")),
                    "DesktopEntry": GLib.Variant("s", "jellyfin"),
                    "SupportedUriSchemes": GLib.Variant("as", []), "SupportedMimeTypes": GLib.Variant("as", [])}
        return {"PlaybackStatus": GLib.Variant("s", "Paused" if ps.get("IsPaused") else "Playing"),
                "Rate": GLib.Variant("d", 1.0), "MinimumRate": GLib.Variant("d", 1.0), "MaximumRate": GLib.Variant("d", 1.0),
                "Volume": GLib.Variant("d", (ps.get("VolumeLevel") or 100) / 100),
                "Metadata": GLib.Variant("a{sv}", self.metadata() if self.session else {}),
                "Position": GLib.Variant("x", (ps.get("PositionTicks") or 0) // 10),
                "CanGoNext": GLib.Variant("b", True), "CanGoPrevious": GLib.Variant("b", True),
                "CanPlay": GLib.Variant("b", True), "CanPause": GLib.Variant("b", True),
                "CanSeek": GLib.Variant("b", bool(ps.get("CanSeek"))), "CanControl": GLib.Variant("b", True)}

    def update(self, session):
        before = (self.session or {}).get("Id"), self.props("org.mpris.MediaPlayer2.Player") if self.session else None
        self.session = session
        if session and not self.owner:
            self.export()
        elif not session and self.owner:
            Gio.bus_unown_name(self.owner)
            for r in self.regs:
                self.conn.unregister_object(r)
            self.owner, self.regs = 0, []
            return
        if session:
            now = self.props("org.mpris.MediaPlayer2.Player")
            changed = {k: v for k, v in now.items() if k != "Position" and (before[1] is None or before[1][k] != v)}
            if changed:
                self.conn.emit_signal(None, PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                                      GLib.Variant("(sa{sv}as)", ("org.mpris.MediaPlayer2.Player", changed, [])))

    def export(self):
        for iface in self.info.interfaces:
            self.regs.append(self.conn.register_object(PATH, iface, self.on_call, self.on_get, None))
        self.owner = Gio.bus_own_name_on_connection(self.conn, BUS_NAME, Gio.BusNameOwnerFlags.NONE, None, None)

    def on_get(self, conn, sender, path, iface, prop):
        return self.props(iface).get(prop)

    def on_call(self, conn, sender, path, iface, method, params, invocation):
        ps = (self.session or {}).get("PlayState", {})
        actions = {"PlayPause": ("PlayPause",), "Play": ("Unpause",), "Pause": ("Pause",), "Stop": ("Stop",),
                   "Next": ("NextTrack",), "Previous": ("PreviousTrack",)}
        if method in actions:
            self.command(*actions[method])
        elif method == "Seek":
            pos = (ps.get("PositionTicks") or 0) + params.unpack()[0] * 10
            self.command("Seek", f"?seekPositionTicks={max(0, pos)}")
        elif method == "SetPosition":
            self.command("Seek", f"?seekPositionTicks={params.unpack()[1] * 10}")
        invocation.return_value(None)


if __name__ == "__main__":
    b = Bridge()
    GLib.idle_add(b.poll)
    GLib.MainLoop().run()
