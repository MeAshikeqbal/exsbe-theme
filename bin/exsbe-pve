#!/usr/bin/env python3
"""Exsbe Lab: talk to the Proxmox cluster with the desktop API token (from KWallet).

  exsbe-pve status              cluster snapshot as JSON (panel widget)
  exsbe-pve list [--fzf]        guests as tab-separated rows (--fzf: coloured, for pvepick)
  exsbe-pve info VMID           pvepick preview: status, load, disks, tags, notes
  exsbe-pve connect VMID        ssh, else console; offers to start a stopped guest
  exsbe-pve confirm VMID ACTION ask, then start | shutdown | reboot | stop
  exsbe-pve do VMID ACTION      start | shutdown | reboot | stop
  exsbe-pve console VMID        container: pct enter in kitty; VM: noVNC app window
  exsbe-pve web [PATH]          Proxmox web UI as an app window
  exsbe-pve ssh-config          write ~/.ssh/config.d/exsbe-pve (a Host per guest)
  exsbe-pve alerts              desktop notifications for cluster problems (timer)

Endpoints are tried in order from ~/.config/exsbe/pve.conf; the one that answered is
remembered. IP endpoints are verified against the cluster CA (exsbe-pve-setup saves it).
With `pbs = URL` in pve.conf and a PBS token (exsbe-pve-setup --pbs), status also covers
Proxmox Backup Server: datastores, garbage collection, verify/prune/sync jobs, failed tasks.
"""
import json, os, re, ssl, subprocess, sys, time, urllib.error, urllib.parse, urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

CONF = Path.home() / ".config/exsbe/pve.conf"
CA = Path.home() / ".config/exsbe/pve-root-ca.pem"
CACHE = Path.home() / ".cache/exsbe"
TOKEN_ID = "exsbe@pve!desktop"
BROWSER = ["flatpak", "run", "com.brave.Browser"]
KITTY = next((k for k in ("/home/linuxbrew/.linuxbrew/bin/kitty", "/usr/bin/kitty") if os.path.exists(k)), "kitty")
STORAGE_WARN = 0.85


def conf():
    c = {"endpoints": ["https://pve.example.lan"], "web": "https://pve.example.lan"}
    if CONF.exists():
        for line in CONF.read_text().splitlines():
            k, _, v = line.partition("=")
            if line.strip() and not line.lstrip().startswith("#") and v:
                c[k.strip()] = v.split() if k.strip() == "endpoints" else v.strip()
    return c


def secret(account):
    r = subprocess.run(["secret-tool", "lookup", "service", "exsbe-pve", "account", account],
                       capture_output=True, text=True)
    return r.stdout.strip()


def token():
    return secret(TOKEN_ID) or sys.exit("no Proxmox token in KWallet; run exsbe-pve-setup root@NODE")


def pbs_snapshot():
    """PBS health, or None when not configured / no token; {"error": ...} when unreachable."""
    url, tok = conf().get("pbs"), secret("exsbe@pbs!desktop")
    if not url or not tok:
        return None

    def get(path):
        req = urllib.request.Request(url.rstrip("/") + "/api2/json" + path,
                                     headers={"Authorization": f"PBSAPIToken=exsbe@pbs!desktop:{tok}"})
        with urllib.request.urlopen(req, timeout=6, context=ssl.create_default_context()) as r:
            return json.load(r)["data"]

    try:
        stores = [{"name": d["store"], "used": d.get("used", 0), "total": d.get("total", 0)}
                  for d in get("/status/datastore-usage")]
        jobs = []
        for kind in ("verify", "prune", "sync"):
            try:
                for j in get(f"/admin/{kind}"):
                    jobs.append({"kind": kind, "id": j.get("id", ""), "store": j.get("store", ""),
                                 "state": j.get("last-run-state", ""), "end": j.get("last-run-endtime", 0),
                                 "next": j.get("next-run", 0)})
            except urllib.error.HTTPError:
                pass  # job type not configured / not permitted
        failed = [{"upid": t["upid"], "type": t.get("worker_type", ""), "id": t.get("worker_id", ""),
                   "status": t.get("status", ""), "end": t.get("endtime", 0)}
                  for t in get(f"/nodes/localhost/tasks?errors=1&since={int(time.time()) - 86400}&limit=50")
                  if t.get("endtime") and t.get("status") not in ("OK", None)]
        return {"url": url, "stores": stores, "jobs": jobs, "failed": failed}
    except (OSError, ValueError, KeyError) as e:
        return {"url": url, "error": str(e)}


class Api:
    def __init__(self):
        self.auth = f"PVEAPIToken={TOKEN_ID}={token()}"
        self.ctx_public = ssl.create_default_context()
        self.ctx_cluster = ssl.create_default_context(cafile=str(CA)) if CA.exists() else None
        last = CACHE / "pve-endpoint"
        eps = conf()["endpoints"]
        if last.exists() and last.read_text().strip() in eps:  # remembered one first
            eps = [last.read_text().strip()] + [e for e in eps if e != last.read_text().strip()]
        self.endpoints, self.base = eps, None

    def _open(self, base, path, method, data, timeout):
        req = urllib.request.Request(base + "/api2/json" + path, method=method,
                                     data=urllib.parse.urlencode(data).encode() if data else None,
                                     headers={"Authorization": self.auth})
        # names under a real certificate use the system store; node IPs use the cluster CA
        host = urllib.parse.urlparse(base).hostname or ""
        ctx = self.ctx_cluster if host.replace(".", "").isdigit() and self.ctx_cluster else self.ctx_public
        with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
            return json.load(r)["data"]

    def call(self, path, method="GET", data=None, timeout=6):
        if self.base:
            return self._open(self.base, path, method, data, timeout)
        err = None
        for base in self.endpoints:
            try:
                out = self._open(base, path, method, data, 3)
            except urllib.error.HTTPError:
                raise  # reachable, the request itself failed
            except (OSError, ValueError) as e:
                err = e
                continue
            self.base = base
            CACHE.mkdir(parents=True, exist_ok=True)
            (CACHE / "pve-endpoint").write_text(base)
            return out
        raise ConnectionError(f"cluster unreachable ({err})")


def snapshot(api):
    res = api.call("/cluster/resources")
    status = api.call("/cluster/status")
    try:
        tasks = api.call("/cluster/tasks")
    except Exception:
        tasks = []
    cluster = next((s for s in status if s["type"] == "cluster"), {})
    ips = {s["name"]: s.get("ip") for s in status if s["type"] == "node"}
    nodes = sorted(({"name": r["node"], "status": r.get("status"), "ip": ips.get(r["node"]),
                     "cpu": r.get("cpu", 0), "mem": r.get("mem", 0), "maxmem": r.get("maxmem", 0),
                     "uptime": r.get("uptime", 0)} for r in res if r["type"] == "node"),
                   key=lambda n: n["name"])
    guests = sorted(({"vmid": r["vmid"], "name": r.get("name", str(r["vmid"])), "type": r["type"],
                      "node": r["node"], "status": r.get("status"), "cpu": r.get("cpu", 0),
                      "mem": r.get("mem", 0), "maxmem": r.get("maxmem", 0), "uptime": r.get("uptime", 0),
                      "tags": r.get("tags", ""), "template": bool(r.get("template"))}
                     for r in res if r["type"] in ("qemu", "lxc")), key=lambda g: g["vmid"])
    storage, seen = [], set()
    for r in res:
        if r["type"] != "storage" or not r.get("maxdisk"):
            continue
        key = r["storage"] if r.get("shared") else f'{r["node"]}/{r["storage"]}'
        if key in seen:
            continue
        seen.add(key)
        storage.append({"name": key, "type": r.get("plugintype"), "used": r.get("disk", 0),
                        "total": r["maxdisk"], "status": r.get("status")})
    storage.sort(key=lambda s: s["name"])
    backups = sorted((t for t in tasks if t.get("type") == "vzdump" and t.get("endtime")),
                     key=lambda t: t["endtime"], reverse=True)
    failed = [t for t in backups if t.get("status") != "OK" and t["endtime"] > time.time() - 86400]
    return {"pbs": pbs_snapshot(),"cluster": cluster.get("name", ""), "quorate": bool(cluster.get("quorate", 1)),
            "endpoint": api.base, "nodes": nodes, "guests": guests, "storage": storage,
            "backup": {"last": backups[0]["endtime"] if backups else 0,
                       "lastStatus": backups[0].get("status") if backups else "",
                       "failed": [{"node": t["node"], "upid": t["upid"], "status": t.get("status", ""),
                                   "id": t.get("id", ""), "end": t["endtime"]} for t in failed]}}


def guest_ip(api, g):
    """First useful IPv4 of a running guest (LAN first), or ''."""
    if g["status"] != "running":
        return ""
    try:
        if g["type"] == "lxc":
            addrs = [i.get("inet", "").split("/")[0] for i in api.call(f'/nodes/{g["node"]}/lxc/{g["vmid"]}/interfaces')]
        else:
            ifs = api.call(f'/nodes/{g["node"]}/qemu/{g["vmid"]}/agent/network-get-interfaces')["result"]
            addrs = [a["ip-address"] for i in ifs for a in i.get("ip-addresses", []) if a.get("ip-address-type") == "ipv4"]
    except Exception:
        return ""
    addrs = [a for a in addrs if a and not a.startswith(("127.", "172.17.", "169.254."))]
    return next((a for a in addrs if a.startswith("192.168.")), addrs[0] if addrs else "")


def with_ips(api, guests):
    with ThreadPoolExecutor(8) as ex:
        for g, ip in zip(guests, ex.map(lambda g: guest_ip(api, g), guests)):
            g["ip"] = ip
    CACHE.mkdir(parents=True, exist_ok=True)
    (CACHE / "pve-ips.json").write_text(json.dumps({str(g["vmid"]): g["ip"] for g in guests if g["ip"]}))
    return guests


def cached_ips():
    try:
        return json.loads((CACHE / "pve-ips.json").read_text())
    except (OSError, ValueError):
        return {}


def find(api, vmid):
    for g in snapshot(api)["guests"]:
        if str(g["vmid"]) == str(vmid):
            return g
    sys.exit(f"no guest {vmid}")


def app_window(url):
    subprocess.Popen(BROWSER + [f"--app={url}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def notify(title, body, urgency="normal", icon="network-server"):
    subprocess.run(["notify-send", "-a", "Lab", "-i", icon, "-u", urgency, title, body])


def cmd_alerts(api):
    state_file = CACHE / "pve-alerts.json"
    try:
        state = json.loads(state_file.read_text())
    except (OSError, ValueError):
        state = {"active": {}, "seenBackups": []}
    try:
        s = snapshot(api)
    except ConnectionError:
        return  # away from home without a route: stay quiet
    now = {}
    for n in s["nodes"]:
        if n["status"] != "online":
            now[f'node:{n["name"]}'] = (f'Node {n["name"]} is offline', "critical")
    if not s["quorate"]:
        now["quorum"] = (f'Cluster {s["cluster"]} lost quorum', "critical")
    for st in s["storage"]:
        if st["total"] and st["used"] / st["total"] >= STORAGE_WARN:
            now[f'storage:{st["name"]}'] = (f'Storage {st["name"]} is {st["used"] / st["total"]:.0%} full', "normal")
    pbs = s.get("pbs") or {}
    for st in pbs.get("stores", []):
        if st["total"] and st["used"] / st["total"] >= STORAGE_WARN:
            now[f'pbs:{st["name"]}'] = (f'PBS datastore {st["name"]} is {st["used"] / st["total"]:.0%} full', "normal")
    for j in pbs.get("jobs", []):
        if j["state"] and j["state"].lower() != "ok":
            now[f'pbsjob:{j["kind"]}:{j["id"]}'] = (f'PBS {j["kind"]} job {j["id"]} failed: {j["state"]}', "critical")
    for key, (msg, urg) in now.items():
        if key not in state["active"]:
            notify("Lab", msg, urg, "dialog-warning")
    for key, msg in state["active"].items():
        if key not in now:
            notify("Lab", f"Resolved: {msg}", "low", "dialog-ok")
    seen = set(state["seenBackups"])
    for t in pbs.get("failed", []):
        if t["upid"] not in seen and state.get("initialized"):
            notify("Lab PBS task failed", f'{t["type"]} {t["id"]}: {t["status"]}', "critical", "dialog-error")
        seen.add(t["upid"])
    for b in s["backup"]["failed"]:
        if b["upid"] not in seen and state.get("initialized"):
            notify("Lab backup failed", f'{b["id"] or "job"} on {b["node"]}: {b["status"]}', "critical", "dialog-error")
        seen.add(b["upid"])
    state = {"initialized": True, "active": {k: m for k, (m, _) in now.items()}, "seenBackups": sorted(seen)[-200:]}
    CACHE.mkdir(parents=True, exist_ok=True)
    state_file.write_text(json.dumps(state))


def cmd_ssh_config(api):
    s = snapshot(api)
    guests = with_ips(api, [g for g in s["guests"] if not g["template"]])
    out = ["# Generated by exsbe-pve ssh-config; overrides go in another file in this directory.",
           f'# {s["cluster"]}: {len(s["nodes"])} nodes, {len(guests)} guests', ""]
    for n in s["nodes"]:
        out += [f'Host {n["name"]}', f'  HostName {n["ip"]}', "  User root", ""]
    for g in guests:
        ip = g["ip"] or cached_ips().get(str(g["vmid"]))
        if ip:
            # Terraform VMs (lab-infra) log in as your own user; everything else as root
            user = [] if "terraform" in g["tags"].split(";") else ["  User root"]
            out += [f'Host {g["name"]}', f"  HostName {ip}", *user, ""]
    d = Path.home() / ".ssh/config.d"
    d.mkdir(mode=0o700, parents=True, exist_ok=True)
    (d / "exsbe-pve").write_text("\n".join(out))
    print(f'{d / "exsbe-pve"}: {sum(1 for l in out if l.startswith("Host "))} hosts')


# --- pvepick (fzf) ---------------------------------------------------------------------
def rgb(h, bold=False):
    return f"\033[{'1;' if bold else ''}38;2;{int(h[1:3], 16)};{int(h[3:5], 16)};{int(h[5:7], 16)}m"


RST, FG, DIM, FAINT = "\033[0m", rgb("#e6e6e8"), rgb("#a8a8b0"), rgb("#5a5a62")
GREEN, AMBER, RED, BLUE, TEAL, ACCENT = (rgb(c) for c in ("#8fc79a", "#e0c47a", "#e07a7a", "#7fa8d6", "#7fc8c8", "#8fa4c0"))
SNAP_CACHE = CACHE / "pve-snapshot.json"


def gib(b):
    return f"{b / 2**30:.1f}G" if b < 100 * 2**30 else f"{b / 2**30:.0f}G"


def dur(s):
    return f"{s // 86400} d" if s >= 86400 else f"{s // 3600} h" if s >= 3600 else f"{s // 60} min"


def bar(frac, width=22):
    frac = max(0.0, min(1.0, frac))
    col = RED if frac >= 0.9 else AMBER if frac >= 0.75 else ACCENT
    n = round(frac * width)
    return f"{col}{'━' * n}{FAINT}{'━' * (width - n)}{RST}"


def ssh_hosts():
    try:
        return {l.split()[1] for l in (Path.home() / ".ssh/config.d/exsbe-pve").read_text().splitlines() if l.startswith("Host ")}
    except OSError:
        return set()


def fzf_list(api):
    """First line: cluster summary (fzf --header-lines 1). Then vmid \\t name \\t status \\t display."""
    s = snapshot(api)
    CACHE.mkdir(parents=True, exist_ok=True)
    SNAP_CACHE.write_text(json.dumps(s))
    ips = cached_ips()
    up = [n for n in s["nodes"] if n["status"] == "online"]
    run = [g for g in s["guests"] if g["status"] == "running" and not g["template"]]
    issues = sum(1 for st in s["storage"] if st["total"] and st["used"] / st["total"] >= STORAGE_WARN) + len(s["backup"]["failed"])
    print("\t\t\t" + f" {ACCENT}{s['cluster']}{RST}  {DIM}{len(up)}/{len(s['nodes'])} nodes · "
          f"{len(run)}/{len([g for g in s['guests'] if not g['template']])} running"
          + (f"{RST} · {RED}{issues} issue{'s' * (issues != 1)}" if issues else "") + RST)
    for g in s["guests"]:
        if g["template"]:
            continue
        on = g["status"] == "running"
        kind = f"{TEAL}ct" if g["type"] == "lxc" else f"{BLUE}vm"
        load = f"{g['cpu'] * 100:3.0f}%  {gib(g['mem']):>5}/{gib(g['maxmem']):<5}" if on else f"{'':4}  {'':5} {'':5}"
        line = (f"{GREEN + '●' if on else FAINT + '○'} {FG if on else DIM}{g['name']:<17}{RST}"
                f"{kind if on else FAINT + kind[-2:]}{RST} {DIM}{g['vmid']:<4} {g['node']:<6}{RST} "
                f"{FG if on else FAINT}{load}{RST} {rgb('#8a8a92') if on else FAINT}{ips.get(str(g['vmid']), '')}{RST}")
        print("\t".join([str(g["vmid"]), g["name"], g["status"], line]))


def fzf_info(api, vmid):
    """Preview pane for one guest (cluster data from the list's cache, config fetched live)."""
    try:
        s = json.loads(SNAP_CACHE.read_text())
    except (OSError, ValueError):
        s = snapshot(api)
    g = next((x for x in s["guests"] if str(x["vmid"]) == str(vmid)), None)
    if not g:
        return print(f"{DIM}no guest {vmid}{RST}")
    cfg = api.call(f'/nodes/{g["node"]}/{g["type"]}/{g["vmid"]}/config')
    on, ct = g["status"] == "running", g["type"] == "lxc"
    ip = cached_ips().get(str(vmid), "")
    print(f" {GREEN + '●' if on else FAINT + '○'} {rgb('#e6e6e8', True)}{g['name']}{RST}"
          f"   {(GREEN + 'running') if on else (DIM + g['status'])}{RST}" + (f"{DIM} · up {dur(g['uptime'])}{RST}" if on else ""))
    print(f"   {DIM}{'container' if ct else 'VM'} {g['vmid']} on {g['node']}" + (f" · {ip}" if ip else "") + RST)
    print()
    cores = cfg.get("cores") or 1
    if on:
        print(f"   {DIM}cpu{RST}   {bar(g['cpu'])} {FG}{g['cpu'] * 100:3.0f}%{RST}  {DIM}of {cores} core{'s' * (cores > 1)}{RST}")
        print(f"   {DIM}mem{RST}   {bar(g['mem'] / g['maxmem'] if g['maxmem'] else 0)} {FG}{gib(g['mem'])}{RST}{DIM} / {gib(g['maxmem'])}{RST}")
    else:
        print(f"   {DIM}cpu   {cores} core{'s' * (cores > 1)}   mem {gib(g['maxmem'])}{RST}")
    disks = [f"{k} {v.split(',')[0]}" + next((f" {p[5:]}" for p in v.split(",") if p.startswith("size=")), "")
             for k, v in sorted(cfg.items(), key=lambda kv: (kv[0] != "rootfs", kv[0]))
             if re.match(r"^(rootfs|mp\d+|scsi\d+|virtio\d+|sata\d+|ide\d+)$", k) and "cloudinit" not in v and "media=cdrom" not in v]
    for i, d in enumerate(disks):
        print(f"   {DIM}{'disk' if i == 0 else '    '}{RST}  {FG}{d}{RST}")
    print()
    extra = []
    if g["tags"]:
        extra.append(("tags", " ".join(f"{ACCENT}#{t}{RST}" for t in g["tags"].split(";"))))
    extra.append(("boot", f"{FG}starts on boot{RST}" if str(cfg.get("onboot", "0")) == "1" else f"{DIM}manual start{RST}"))
    if not ct:
        extra.append(("cpu", f"{FG}{cfg.get('cpu', 'kvm64')}{RST}"))
    for k, v in extra:
        print(f"   {DIM}{k:<5}{RST} {v}")
    # Proxmox notes, minus images and link-only lines (community-scripts add a block of them)
    notes = [re.sub(r"<[^>]+>", " ", l).strip() for l in cfg.get("description", "").splitlines()
             if not re.search(r"<a\s|<img|\]\(|href=|^\s*!\[", l)]
    notes = [re.sub(r"\s+", " ", l) for l in notes if l and not l.startswith("#")]
    if notes:
        print(f"\n   {DIM}notes{RST}")
        for l in notes[:6]:
            print(f"   {FG}{l[:70]}{RST}")
    hint = (f"ssh {g['name']}" if g["name"] in ssh_hosts() else "console (pct enter)" if ct else "console (noVNC)") if on else "start it"
    print(f"\n   {FAINT}⏎ {hint}{RST}")


def connect(api, vmid):
    """Enter in the picker: ssh when possible, else the console; a stopped guest offers to start."""
    g = find(api, vmid)
    if g["status"] != "running":
        if input(f"\n  {g['name']} is {g['status']}. Start it? [y/N] ").strip().lower() != "y":
            return
        api.call(f'/nodes/{g["node"]}/{g["type"]}/{g["vmid"]}/status/start', "POST")
        print(f"  starting {g['name']}", end="", flush=True)
        for _ in range(60):
            time.sleep(2)
            print(".", end="", flush=True)
            if find(api, vmid)["status"] == "running":
                break
        print()
        time.sleep(3)  # let sshd come up
    if g["name"] in ssh_hosts():
        os.execvp("ssh", ["ssh", g["name"]])
    if g["type"] == "lxc":
        node_ip = next(n["ip"] for n in snapshot(api)["nodes"] if n["name"] == g["node"])
        os.execvp("ssh", ["ssh", "-t", f"root@{node_ip}", "pct", "enter", str(g["vmid"])])
    app_window(f'{conf()["web"]}/?console=kvm&novnc=1&vmid={g["vmid"]}&vmname={g["name"]}&node={g["node"]}&resize=scale')
    print(f"  {g['name']} has no IP for ssh; opened its console in a window")


def confirm(api, vmid, action):
    """Ask before shutdown / reboot / stop (start needs no confirmation)."""
    g = find(api, vmid)
    if action != "start":
        verb = {"shutdown": "Shut down", "reboot": "Reboot", "stop": "Force-stop"}.get(action, action)
        if input(f"\n  {verb} {g['name']} ({'ct' if g['type'] == 'lxc' else 'vm'} {g['vmid']} on {g['node']})? [y/N] ").strip().lower() != "y":
            return
    api.call(f'/nodes/{g["node"]}/{g["type"]}/{g["vmid"]}/status/{action}', "POST")
    time.sleep(1.5)


def main():
    a = sys.argv[1:] or ["status"]
    api = Api()
    try:
        if a[0] == "status":
            json.dump(snapshot(api), sys.stdout)
        elif a[0] == "list":
            if "--fzf" in a:
                fzf_list(api)
            else:
                ips = cached_ips()
                for g in snapshot(api)["guests"]:
                    kind = "ct" if g["type"] == "lxc" else "vm"
                    print("\t".join([str(g["vmid"]), g["name"], g["status"], kind, g["node"], ips.get(str(g["vmid"]), "")]))
        elif a[0] == "info":
            fzf_info(api, a[1])
        elif a[0] == "connect":
            connect(api, a[1])
        elif a[0] == "confirm":
            confirm(api, a[1], a[2])
        elif a[0] == "do":
            g = find(api, a[1])
            api.call(f'/nodes/{g["node"]}/{g["type"]}/{g["vmid"]}/status/{a[2]}', "POST")
        elif a[0] == "console":
            g = find(api, a[1])
            if g["type"] == "lxc":
                node_ip = next(n["ip"] for n in snapshot(api)["nodes"] if n["name"] == g["node"])
                os.execvp(KITTY, [KITTY, "--title", g["name"], "ssh", "-t", f"root@{node_ip}", "pct", "enter", str(g["vmid"])])
            app_window(f'{conf()["web"]}/?console=kvm&novnc=1&vmid={g["vmid"]}&vmname={g["name"]}&node={g["node"]}&resize=scale')
        elif a[0] == "web":
            if len(a) > 1 and a[1].isdigit():  # a guest's page
                g = find(api, a[1])
                app_window(f'{conf()["web"]}/#v1:0:={g["type"]}%2F{g["vmid"]}')
            else:
                app_window(conf()["web"] + (a[1] if len(a) > 1 else ""))
        elif a[0] == "ssh-config":
            cmd_ssh_config(api)
        elif a[0] == "alerts":
            cmd_alerts(api)
        else:
            sys.exit(__doc__)
    except ConnectionError as e:
        if a[0] == "status":
            json.dump({"error": str(e)}, sys.stdout)
        else:
            sys.exit(str(e))
    except urllib.error.HTTPError as e:
        sys.exit(f"Proxmox: {e.code} {e.reason}")


if __name__ == "__main__":
    main()
