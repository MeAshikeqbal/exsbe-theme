#!/usr/bin/env bash
# One-time setup for the Lab tools, over root SSH: least-privilege users and API tokens on the
# Proxmox cluster (and, with --pbs, a read-only token on Proxmox Backup Server). Token secrets are
# piped straight into KWallet (Secret Service) - never printed or written to disk.
# Re-running is safe: roles are refreshed, existing tokens are kept.
# Usage: exsbe-pve-setup root@NODE [--pbs root@PBS]
set -euo pipefail
node=${1:?usage: exsbe-pve-setup root@NODE [--pbs root@PBS]}
pbs_host=""
[ "${2:-}" = "--pbs" ] && pbs_host=${3:?--pbs needs root@PBS}
pve() { ssh -o BatchMode=yes "$node" "$@"; }
pbs() { ssh -o BatchMode=yes "$pbs_host" "$@"; }

# store ID LABEL  <secret on stdin>; refuses anything that is not a token secret (a UUID)
store() {
  python3 -c '
import json, re, sys
d = sys.stdin.read()
m = re.search(r"\{.*\}", d, re.S)
v = json.loads(m.group(0)).get("value", "") if m else ""
if not re.fullmatch(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", v):
    sys.exit("token output not understood; nothing stored")
sys.stdout.write(v)' | secret-tool store --label="$2" service exsbe-pve account "$1"
  echo "stored $1 in KWallet"
}
# have ID: a non-empty secret is already in KWallet
have() { [ -n "$(secret-tool lookup service exsbe-pve account "$1" 2>/dev/null)" ]; }

# user ROLE PRIVS COMMENT  ->  user@pve with ROLE on /
user() {
  pve "pveum role add $2 --privs '$3' 2>/dev/null || pveum role modify $2 --privs '$3'
       pveum user add $1@pve --comment '$4' 2>/dev/null || true
       pveum acl modify / --users $1@pve --roles $2"
}
# token USER NAME  ->  KWallet item service=exsbe-pve account=USER@pve!NAME
token() {
  local id="$1@pve!$2"
  have "$id" && return
  pve "pveum user token remove $1@pve $2 2>/dev/null; pveum user token add $1@pve $2 --privsep 0 --output-format json" |
    store "$id" "Proxmox API token $id"
}

# desktop panel, picker, alerts, ssh config: see everything, power/console guests, change nothing
user exsbe ExsbeDesktop \
  "Sys.Audit,VM.Audit,VM.PowerMgmt,VM.Console,VM.GuestAgent.Audit,Datastore.Audit,Pool.Audit,SDN.Audit" \
  "Exsbe desktop (panel, picker, alerts)"
token exsbe desktop

# Terraform (bpg/proxmox): create, clone and configure guests; no user/permission/node admin
user terraform ExsbeTerraform \
  "Datastore.AllocateSpace,Datastore.AllocateTemplate,Datastore.Audit,Pool.Allocate,Pool.Audit,Sys.Audit,Sys.AccessNetwork,SDN.Use,VM.Allocate,VM.Audit,VM.Clone,VM.Config.CDROM,VM.Config.Cloudinit,VM.Config.CPU,VM.Config.Disk,VM.Config.HWType,VM.Config.Memory,VM.Config.Network,VM.Config.Options,VM.GuestAgent.Audit,VM.Migrate,VM.PowerMgmt" \
  "Terraform"
token terraform tf

# cluster CA, so nodes can be reached by IP with verified TLS when the proxy name is unavailable
mkdir -p ~/.config/exsbe
pve cat /etc/pve/pve-root-ca.pem > ~/.config/exsbe/pve-root-ca.pem

# PBS: read-only (Audit on /) for datastore, garbage collection, verify and task status.
# A PBS token needs its own ACL on top of its user's.
if [ -n "$pbs_host" ]; then
  id='exsbe@pbs!desktop'
  pbs "proxmox-backup-manager user create exsbe@pbs --comment 'Exsbe desktop (read-only)' 2>/dev/null || true
       proxmox-backup-manager acl update / Audit --auth-id exsbe@pbs"
  if ! have "$id"; then
    secret-tool clear service exsbe-pve account "$id" 2>/dev/null || true
    pbs "proxmox-backup-manager user delete-token exsbe@pbs desktop >/dev/null 2>&1; proxmox-backup-manager user generate-token exsbe@pbs desktop" |
      store "$id" "PBS API token $id"
  fi
  pbs "proxmox-backup-manager acl update / Audit --auth-id '$id'"
fi
echo "done"
