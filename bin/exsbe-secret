#!/usr/bin/env bash
# Store a secret for the Lab tools in KWallet (service=exsbe-pve), typed without echo.
# Usage: exsbe-secret ACCOUNT        e.g.  exsbe-secret jellyfin
set -euo pipefail
account=${1:?usage: exsbe-secret ACCOUNT}
read -rsp "Secret for $account (input hidden): " secret; echo
[ -n "$secret" ] || { echo "empty, nothing stored" >&2; exit 1; }
printf %s "$secret" | secret-tool store --label="Exsbe $account" service exsbe-pve account "$account"
echo "stored $account in KWallet"
