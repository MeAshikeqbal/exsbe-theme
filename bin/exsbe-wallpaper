#!/usr/bin/env python3
"""Set the wallpaper for today's design and the current part of the day.

Each design is a folder of five images (1-morning ... 5-midnight). Every ISO week the designs are
shuffled, so each weekday gets a different one; the shuffle is seeded by the week, so it is stable
across reboots and timer runs.

The parts of the day follow the sun: the times come from Plasma's Night Time service (the same
schedule night light uses), computed for the location set in the Exsbe weather widget.
  midnight   00:00 -> dawn
  morning    dawn -> solar noon
  afternoon  solar noon -> 30 min before dusk
  evening    30 min before dusk -> 2 h after dark (between 20:00 and 23:00)
  night      -> 24:00
Without the Night Time service it falls back to 06 / 12 / 17 / 21.

  exsbe-wallpaper           apply now (does nothing when the right image is already set)
  exsbe-wallpaper --force   apply even if nothing changed
  exsbe-wallpaper --today   show today's sun times and when each image comes up
  exsbe-wallpaper --week    show this week's line-up
"""
import datetime as dt
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path

DIR = Path.home() / "Pictures/Wallpapers/exsbe"
CONFIG = Path.home() / ".config"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "exsbe/wallpaper"
SLOTS = ["1-morning", "2-afternoon", "3-evening", "4-night", "5-midnight"]


def run(*cmd, check=False):
    return subprocess.run(cmd, capture_output=True, text=True, check=check)


def designs(day):
    """This ISO week's order of the design folders (Monday first)."""
    year, week, _ = day.isocalendar()
    seed = f"{year}-W{week:02d}"
    names = sorted(p.name for p in DIR.iterdir() if p.is_dir()) if DIR.is_dir() else []
    return sorted(names, key=lambda d: hashlib.md5(f"{seed}/{d}".encode()).hexdigest()[:12])


# --- location: the weather widget is the single place to set it ---------------------------------
def weather_location():
    rc = CONFIG / "plasma-org.kde.plasma.desktop-appletsrc"
    try:
        text = rc.read_text()
    except OSError:
        return None
    m = re.search(r"^\[(Containments\]\[\d+\]\[Applets\]\[\d+)\]\n(?:[^\[].*\n)*?plugin=com\.exsbe\.weather$", text, re.M)
    if not m:
        return None
    conf = re.search(r"^\[" + re.escape(m.group(1)) + r"\]\[Configuration\]\[General\]\n((?:[^\[].*\n?)*)", text, re.M)
    if not conf:
        return None
    kv = dict(re.findall(r"^(latitude|longitude)=(.*)$", conf.group(1), re.M))
    try:
        lat, lon = float(kv["latitude"]), float(kv["longitude"])
    except (KeyError, ValueError):
        return None
    return (lat, lon) if (lat, lon) != (0, 0) else None


def kread(group, key):
    return run("kreadconfig6", "--file", "knighttimerc", "--group", group, "--key", key).stdout.strip()


def sync_night_time():
    """Point Plasma's Night Time service at the weather widget's location, so night light and the
    wallpaper follow the real sunset. Left alone when the user picked fixed times in System Settings."""
    loc = weather_location()
    if not loc or kread("General", "Source") not in ("", "Location"):
        return
    current = (kread("Location", "Automatic"), kread("Location", "Latitude"), kread("Location", "Longitude"))
    try:
        if current[0] == "false" and (round(float(current[1]), 4), round(float(current[2]), 4)) == (round(loc[0], 4), round(loc[1], 4)):
            return
    except ValueError:
        pass
    for group, key, value in (("Location", "Automatic", "false"), ("Location", "Latitude", str(loc[0])),
                              ("Location", "Longitude", str(loc[1]))):
        run("kwriteconfig6", "--file", "knighttimerc", "--group", group, "--key", key, value)
    # the service reads its config at start; KWin follows it over D-Bus
    run("systemctl", "--user", "try-restart", "plasma-knighttimed.service")


# --- the day's schedule --------------------------------------------------------------------------
def sun_schedule(day):
    """(dawn, noon, dusk start, dusk end) for `day` from the Night Time service, or None."""
    mgr = ("org.kde.NightTime", "/org/kde/NightTime/Manager", "org.kde.NightTime.Manager")
    r = run("busctl", "--user", "--json=short", "call", *mgr, "Subscribe", "a{sv}", "0")
    if r.returncode:
        return None
    try:
        reply = json.loads(r.stdout)["data"][0]
        run("busctl", "--user", "call", *mgr, "Unsubscribe", "u", str(reply["Cookie"]["data"]))
        rows = reply["Schedule"]["data"][1]["data"]
    except (KeyError, IndexError, ValueError, TypeError):
        return None
    for noon, dawn, _dawn_end, dusk, dusk_end in rows:   # milliseconds since the epoch
        t = [dt.datetime.fromtimestamp(x / 1000) for x in (dawn, noon, dusk, dusk_end)]
        if t[1].date() == day:
            return t
    return None


def boundaries(day):
    """Start time of each slot on `day`, in SLOTS order, plus where the times came from."""
    at = lambda h, m=0: dt.datetime.combine(day, dt.time(h, m))
    sun = sun_schedule(day)
    if not sun:
        return [at(6), at(12), at(17), at(21), at(0)], "fixed hours"
    dawn, noon, dusk, dusk_end = sun
    night = min(max(dusk_end + dt.timedelta(hours=2), at(20)), at(23))
    evening = min(dusk - dt.timedelta(minutes=30), night)
    return [dawn, noon, evening, night, at(0)], "sun"


def slot_now(now):
    starts, _ = boundaries(now.date())
    current = "5-midnight"
    for slot, start in sorted(zip(SLOTS, starts), key=lambda x: x[1]):
        if now >= start:
            current = slot
    return current


def image(day, slot):
    order = designs(day)
    if not order:
        sys.exit(f"exsbe-wallpaper: no designs in {DIR}")
    design = order[day.weekday() % len(order)]
    hits = sorted((DIR / design).glob(slot + ".*"))
    if not hits:
        sys.exit(f"exsbe-wallpaper: missing {DIR / design / slot}.*")
    return design, hits[0]


def apply(force):
    sync_night_time()
    now = dt.datetime.now()
    _, img = image(now.date(), slot_now(now))
    try:
        if not force and STATE.read_text() == str(img):
            return
    except OSError:
        pass
    # lock screen follows the same image
    run("kwriteconfig6", "--file", "kscreenlockerrc", "--group", "Greeter", "--group", "Wallpaper",
        "--group", "org.kde.image", "--group", "General", "--key", "Image", f"file://{img}")
    if run("plasma-apply-wallpaperimage", str(img)).returncode == 0:
        STATE.parent.mkdir(parents=True, exist_ok=True)
        STATE.write_text(str(img))
    else:
        sys.exit("exsbe-wallpaper: plasma-apply-wallpaperimage failed (is plasmashell running?)")


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    today = dt.date.today()
    if arg == "--week":
        monday = today - dt.timedelta(days=today.weekday())
        order = designs(today)
        for i in range(7):
            mark = "  <- today" if i == today.weekday() else ""
            print(f"{(monday + dt.timedelta(days=i)).strftime('%a')}  {order[i % len(order)] if order else '-'}{mark}")
    elif arg == "--today":
        starts, source = boundaries(today)
        now = dt.datetime.now()
        design, _ = image(today, slot_now(now))
        print(f"{design}, times from {source}" + ("" if source == "sun" else " (Night Time service unavailable)"))
        for slot, start in sorted(zip(SLOTS, starts), key=lambda x: x[1]):
            print(f"  {start:%H:%M}  {slot[2:]}" + ("  <- now" if slot == slot_now(now) else ""))
    elif arg in ("", "--force"):
        apply(arg == "--force")
    else:
        print(__doc__.strip())
        sys.exit(0 if arg in ("-h", "--help") else 1)


if __name__ == "__main__":
    main()
