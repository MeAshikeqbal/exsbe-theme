#!/usr/bin/env bash
# Pick a Proxmox guest with fzf.  Enter: ssh   Ctrl+O: console   Ctrl+W: web UI
# Ctrl+S: start   Ctrl+X: shutdown   Ctrl+R: reboot   (the list refreshes after each action)
set -euo pipefail
export PATH="$HOME/.local/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"
rows="exsbe-pve list --fzf"
act() { echo "execute-silent(exsbe-pve do {1} $1 >/dev/null 2>&1; sleep 1)+reload($rows)"; }
pick=$($rows | fzf --ansi --delimiter '\t' --with-nth 3 --prompt 'lab ❯ ' --height 100% --layout reverse \
  --header 'enter ssh · ^o console · ^w web · ^s start · ^x shutdown · ^r reboot' \
  --bind "ctrl-s:$(act start)" --bind "ctrl-x:$(act shutdown)" --bind "ctrl-r:$(act reboot)" \
  --bind "ctrl-o:execute-silent(setsid -f exsbe-pve console {1} >/dev/null 2>&1)" \
  --bind "ctrl-w:execute-silent(exsbe-pve web {1} >/dev/null 2>&1)" \
  --color 'bg:#232326,bg+:#2e2e32,header:#5a5a62,prompt:#8fa4c0,pointer:#8fa4c0' | cut -f2) || exit 0
[ -n "$pick" ] && exec ssh "$pick"
